---
import "./hero.scss";
import { Image } from "astro:assets";

const { heroImage, heroTitle, heroContent } = Astro.props.data;

const imageSrc = heroImage?.node?.sourceUrl;
const imageAlt = heroImage?.node?.altText || "";
---

<div class="contact-hero">
  <div class="contact-hero-background">
    <Image
      src={imageSrc}
      alt={imageAlt}
      format="webp"
      widths={[800, 1200, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      inferSize={true}
      class=""
    />
  </div>
  <div class="contact-hero-content">
    <div class="contact-hero-content-container">
      <div class="contact-hero-content-container-title" data-animate="fade-up">
        <h2 set:html={heroTitle} />
      </div>
    </div>
  </div>
</div>
