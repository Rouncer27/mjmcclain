---
import { Picture } from "astro:assets";
import "./mainLogo.scss";

// 1️⃣ Destructure incoming data
const {
  mainLogo: {
    node: { sourceUrl, altText, mediaDetails: { width, height } = {} },
  },
} = Astro.props.data;
---

<div class="main-logo">
  <div class="main-logo-wrapper">
    <Picture
      src={sourceUrl}
      alt={altText}
      width={width}
      height={height}
      formats={["avif", "webp"]}
    />
  </div>
</div>
