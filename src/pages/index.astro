---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Home/Hero/Hero.astro";
import ImageContent from "../components/Home/ImageContent/ImageContent.astro";

import { Page_Seo_Query } from "../data/page/queries";
import { Hero_Query, Image_Content_Query } from "../data/home/queries";

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
      query homePageQuery {
        page(id: "/", idType: URI) {
          ${Page_Seo_Query}
          homePage {
            ${Hero_Query}
            ${Image_Content_Query}
          }
        }
      }
	  `,
  }),
});

const {
  data: {
    page: { seoMetaTags, homePage },
  },
} = await response.json();
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
  isHome={true}
>
  <Hero data={homePage.hero} />
  <ImageContent data={homePage.imageContent} />
</Layout>
