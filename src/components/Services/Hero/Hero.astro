---
import "./hero.scss";
import { Image } from "astro:assets";

const { heroImage, heroTitle, heroContent } = Astro.props.data;

const imageSrc = heroImage?.node?.sourceUrl;
const imageAlt = heroImage?.node?.altText || "";
---

<div class="services-hero">
  <div class="services-hero-background">
    <Image
      src={imageSrc}
      alt={imageAlt}
      format="webp"
      widths={[800, 1200, 1600, 2000]}
      sizes="100vw"
      loading="eager"
      inferSize={true}
      class=""
    />
  </div>
  <div class="services-hero-content">
    <div class="services-hero-content-container">
      <div class="services-hero-content-container-title">
        <h2 set:html={heroTitle} />
      </div>
      <div
        class="services-hero-content-container-content"
        set:html={heroContent}
      />
    </div>
  </div>
</div>
