---
import "./callout.scss";
import Wrapper from "../../common/shared/Wrapper.astro";
import Button from "../../common/shared/Button.astro";

const { title, buttonLink, buttonText } = Astro.props.data;
---

<div class="services-callout">
  <Wrapper classes='services-callout-wrapper"'>
    <div class="services-callout-content">
      <div class="services-callout-content-title">
        <h2>{title}</h2>
      </div>
      <div class="services-callout-content-link">
        <Button ele="a" btnstyle="one" href={buttonLink.edges[0].node.uri}>
          {buttonText}
        </Button>
      </div>
    </div>
  </Wrapper>
</div>
