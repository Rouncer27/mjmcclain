---
import "./workWith.scss";
import Wrapper from "../../common/shared/Wrapper.astro";
import Button from "../../common/shared/Button.astro";
import { Image } from "astro:assets";

const { title, content, image, buttonLink, buttonText } = Astro.props.data;

const imageSrc = image?.node?.sourceUrl;
const imageAlt = image?.node?.altText || "";
---

<div class="work-with">
  <Wrapper classes="work-with-wrapper">
    <div class="work-with-content">
      <div class="work-with-content-title">
        <h2>{title}</h2>
      </div>
      <div class="work-with-content-main" set:html={content} />
      <div class="work-with-content-link">
        <Button ele="a" btnstyle="one" href={buttonLink.edges[0].node.uri}>
          {buttonText}
        </Button>
      </div>
    </div>
    <div class="work-with-image">
      <div class="work-with-image-container">
        <Image
          src={imageSrc}
          alt={imageAlt}
          format="webp"
          widths={[800, 1200, 1600, 2000]}
          sizes="100vw"
          loading="eager"
          inferSize={true}
          class=""
        />
      </div>
    </div>
  </Wrapper>
</div>
