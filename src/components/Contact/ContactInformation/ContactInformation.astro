---
import "./contactInformation.scss";
import Wrapper from "../../common/shared/Wrapper.astro";

const { address, phoneNumber, email } = Astro.props.data;

const phoneHref = `tel:+1${phoneNumber?.replace(/\D/g, "")}`;
const mapHref = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(address)}`;
---

<div class="contact-information">
  <Wrapper classes="contact-information-wrapper">
    <div class="contact-information-lines" data-animate="stagger">
      <p>
        <a href={mapHref} target="_blank" rel="noopener noreferrer">
          {address}
        </a>
      </p>
      <p>
        Phone <a href={phoneHref}>{phoneNumber}</a>
      </p>
      <p>
        Email <a href={`mailto:${email}`}>{email}</a>
      </p>
    </div>
  </Wrapper>
</div>
