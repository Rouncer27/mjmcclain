---
import Wrapper from "../../common/shared/Wrapper.astro";
import Wysiwyg from "../../common/shared/Wysiwyg.astro";

import "./mainContent.scss";

const { title, content } = Astro.props.data;
---

<div class="main-content">
  <Wrapper classes="main-content-wrapper">
    {
      title && (
        <div class="main-content-title" data-animate="fade-up">
          <h2>{title}</h2>
        </div>
      )
    }
    <Wysiwyg>
      <div
        class="main-content-wysiwyg"
        data-animate="fade-up"
        set:html={content}
      />
    </Wysiwyg>
  </Wrapper>
</div>
