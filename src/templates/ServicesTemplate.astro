---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Services/Hero/Hero.astro";
import PageIntro from "../components/Services/PageIntro/PageIntro.astro";
import Services from "../components/Services/Services/Services.astro";
import Callout from "../components/Services/Callout/Callout.astro";

import { Page_Seo_Query } from "../data/page/queries";
import {
  Hero_Query,
  Page_Intro_Query,
  Services_Query,
  Callout_Query,
} from "../data/services/queries";

// 2️⃣ Get the actual page data by slug
const { uri } = Astro.params;

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
		query servicesQuery($slug: ID!) {
			page(id: $slug, idType: URI) {
				${Page_Seo_Query}
        template {
          ... on Template_Services {
            servicesTemplate {
              ${Hero_Query}
              ${Page_Intro_Query}
              ${Services_Query}
              ${Callout_Query}
            }
          }
        }
      }
    }
	`,
    variables: { slug: `${uri}` },
  }),
});

const {
  data: {
    page: {
      seoMetaTags,
      template: { servicesTemplate },
    },
  },
} = await response.json();
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage?.node?.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
  isHome={false}
>
  <Hero data={servicesTemplate.hero} />
  <PageIntro data={servicesTemplate.pageIntro} />
  <Services data={servicesTemplate.services} />
  <Callout data={servicesTemplate.callout} />
</Layout>
