---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Contact/Hero/Hero.astro";
import ContactInformation from "../components/Contact/ContactInformation/ContactInformation.astro";
import ContactFormSection from "../components/Contact/ContactFormSection/ContactFormSection.astro";
import ImageRow from "../components/Contact/ImageRow/ImageRow.astro";
import LocationMap from "../components/Contact/LocationMap/LocationMap.astro";

import { Page_Seo_Query } from "../data/page/queries";
import {
  Hero_Query,
  Contact_Information_Query,
  Image_Row_Query,
} from "../data/contact/queries";

// 2️⃣ Get the actual page data by slug
const { uri } = Astro.params;

const response = await fetch(`${import.meta.env.WPGRAPHQL_URL}`, {
  method: "POST",
  headers: {
    "content-type": "application/json",
  },
  body: JSON.stringify({
    query: `
		query contactQuery($slug: ID!) {
			page(id: $slug, idType: URI) {
				${Page_Seo_Query}
        template {
          ... on Template_Contact {
            contactTemplate {
              ${Hero_Query}
              ${Image_Row_Query}
            }
          }
        }
      }
      ${Contact_Information_Query}
    }
	`,
    variables: { slug: `${uri}` },
  }),
});

const {
  data: {
    contactInformation: { contactInformation },
    page: {
      seoMetaTags,
      template: { contactTemplate },
    },
  },
} = await response.json();
---

<Layout
  metaImg={seoMetaTags.seoMetaInformation.metaImage.sourceUrl}
  metaTitle={seoMetaTags.seoMetaInformation.metaTitle}
  metaDescription={seoMetaTags.seoMetaInformation.metaDescription}
  isHome={false}
>
  <Hero data={contactTemplate.hero} />
  <ContactInformation data={contactInformation} />
  <ContactFormSection />
  <ImageRow data={contactTemplate.imageRow} />
  <LocationMap data={contactInformation} />
</Layout>
