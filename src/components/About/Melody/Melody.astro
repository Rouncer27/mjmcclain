---
import "./melody.scss";
import Wrapper from "../../common/shared/Wrapper.astro";
import { Image } from "astro:assets";

const { title, content, image } = Astro.props.data;

const imageSrc = image?.node?.sourceUrl;
const imageAlt = image?.node?.altText || "";
---

<div class="melody">
  <Wrapper classes="melody-wrapper">
    <div class="melody-image" data-animate="fade-up">
      <div class="melody-image-container">
        <Image
          src={imageSrc}
          alt={imageAlt}
          format="webp"
          widths={[800, 1200, 1600, 2000]}
          sizes="100vw"
          loading="lazy"
          inferSize={true}
          class=""
        />
      </div>
    </div>
    <div class="melody-content" data-animate="stagger">
      <div class="melody-content-title">
        <h2>{title}</h2>
      </div>
      <div class="melody-content-main" set:html={content} />
    </div>
  </Wrapper>
</div>
